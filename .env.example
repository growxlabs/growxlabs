# Supabase (Required)
# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_HRMS_DOCUMENTS_BUCKET=hrms-documents
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require

# NextAuth (Required for Dashboard/Admin)
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret
# Development: http://localhost:3000. Production must be exactly https://growxlabs.tech
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Candidate Auth & Login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Service-oriented HRMS Release 01
# Dedicated HRMS Go Gateway. In production this must be its external/internal
# service domain and must never be growxlabs.tech or the Vercel application.
HRMS_GATEWAY_URL=http://localhost:8080
HRMS_BFF_SHARED_SECRET=replace-with-a-long-random-secret
DEFAULT_ORGANISATION_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_DEFAULT_ORGANISATION_ID=00000000-0000-0000-0000-000000000000
# Razorpay (Required for Payments)
RAZORPAY_KEY_ID=rzp_test_your_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# AI Models (Optional for Chat Features)
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
SERPER_API_KEY=your-serper-api-key

# Email Service (Optional for Outreach)
RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL=GrowXLabs People <noreply@growxlabs.tech>

# Zoom Meeting SDK credentials (server-only; never use NEXT_PUBLIC_ names)
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_PASSCODE_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# App Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ENV=development
COMMAND_CENTER_LOG_LEVEL=INFO

# Upstash Redis (For Edge Rate Limiting)
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Cloudflare R2 (Private Command Center artifacts)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=gxl-command-center-artifacts

# Cloudflare Turnstile (Bot Protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# HRMS Release 03
ONBOARDING_SERVICE_URL=http://localhost:8084
ONBOARDING_SERVICE_ADDR=:8084
ONBOARDING_SERVICE_ACTOR_ID=00000000-0000-0000-0000-000000000001
ONBOARDING_EMPLOYEE_ROLE_ID=
ONBOARDING_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# HRMS Release 04 serverless scheduled operations
CRON_SECRET=replace-with-a-long-random-secret
HEALTHCHECK_SECRET=replace-with-a-separate-long-random-secret
HRMS_SYSTEM_ACTOR_USER_ID=00000000-0000-0000-0000-000000000001

# HRMS Release 05 services and asynchronous delivery
ASSETS_SERVICE_URL=http://localhost:8085
ASSETS_SERVICE_ADDR=:8085
LEARNING_SERVICE_URL=http://localhost:8086
LEARNING_SERVICE_ADDR=:8086
LEARNING_SERVICE_ACTOR_ID=00000000-0000-0000-0000-000000000001
CERTIFICATE_WORKER_BATCH=25
QSTASH_TOKEN=
RELEASE05_WORKER_SECRET=replace-with-a-long-random-secret
ONBOARDING_DOCUMENT_CATEGORY_ID=
RELEASE05_INTEGRATION_BATCH=25

# Command Center V2 Phase 3 durable execution
# Production URLs use https://<deployment>/api/internal/<service>; the local
# listener addresses below are optional development utilities only.
COMMAND_CENTER_PHASE3_EXECUTION_ENABLED=false
COMMAND_CENTER_PHASE4_SERVICES_ENABLED=false
EXECUTION_ENGINE_INTERNAL_URL=http://localhost:8091
EXECUTION_SCHEDULER_INTERNAL_URL=http://localhost:8092
EXECUTION_WORKER_INTERNAL_URL=http://localhost:8093
INTERNAL_API_GATEWAY_URL=http://localhost:8097
INTERNAL_API_GATEWAY_ADDRESS=:8097
TOOL_SERVICE_INTERNAL_URL=http://localhost:8094
TOOL_SERVICE_ADDRESS=:8094
CAPABILITY_SERVICE_INTERNAL_URL=http://localhost:8095
CAPABILITY_SERVICE_ADDRESS=:8095
SKILL_SERVICE_INTERNAL_URL=http://localhost:8096
SKILL_SERVICE_ADDRESS=:8096
CRM_SERVICE_INTERNAL_URL=http://localhost:8101
CRM_SERVICE_ADDRESS=:8101
FINANCE_SERVICE_INTERNAL_URL=http://localhost:8102
FINANCE_SERVICE_ADDRESS=:8102
HR_SERVICE_INTERNAL_URL=http://localhost:8103
HR_SERVICE_ADDRESS=:8103
PROJECT_SERVICE_INTERNAL_URL=http://localhost:8104
PROJECT_SERVICE_ADDRESS=:8104
MARKETING_SERVICE_INTERNAL_URL=http://localhost:8105
MARKETING_SERVICE_ADDRESS=:8105
PHASE1_TOOL_COMPATIBILITY_FALLBACK_ENABLED=true
EXECUTION_ENGINE_ADDRESS=:8091
TASK_SCHEDULER_ADDRESS=:8092
EXECUTION_WORKER_ADDRESS=:8093
EXECUTION_WORKER_ID=worker-local-1
GXL_WEB_BASE_URL=http://localhost:3000
EXECUTION_SERVICE_JWT_SECRET=replace-with-at-least-32-random-bytes
SCHEDULER_BATCH_SIZE=50
SCHEDULER_INTERVAL_MS=1000
