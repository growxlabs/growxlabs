# GrowxLabs Desktop — Environment Configuration
# Copy this file to .env and adjust values as needed.

# The production URL loaded by the Electron desktop shell.
# Default: https://growxlabs.tech
GROWX_DESKTOP_URL=https://growxlabs.tech

# Optional: Staging URL for internal testing.
# GROWX_DESKTOP_URL=https://staging.growxlabs.tech
